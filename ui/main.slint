// The main window: the devices tab with a card per device on the air and a row per device
// that isn't, and the settings tab. Every text and value comes from Rust; edits go back through the callbacks.

import { ScrollView } from "std-widgets.slint";
import { Palette, T, Glyph, Card, SectionHeader, Hint, Btn, IconButton, TabButton, Toggle, OptionButton, StepSlider, Field } from "theme.slint";

export struct DeviceCard {
    id: string,
    name: string,
    glyph: string,
    subtitle: string,
    level-text: string,
    color: color,
    charging: bool,
    // Charging, but the level can't be read right now: no number, a dimmed full bar instead
    indeterminate: bool,
    fill: float,
}

export struct DeviceSettingsRow {
    id: string,
    glyph: string,
    custom-name: string,
    default-name: string,
    source: string,
    visible: bool,
    alerts: bool,
    custom-thresholds: bool,
    low: int,
    critical: int,
}

component DeviceCardView inherits Card {
    in property <DeviceCard> card;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 0;
            Glyph {
                width: 38px;
                text: root.card.glyph;
                font-size: 22px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.card.name;
                    font-size: 15px;
                    font-weight: 600;
                    color: Palette.text;
                    overflow: elide;
                }
                Text {
                    text: root.card.subtitle;
                    font-size: 12px;
                    color: Palette.secondary;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 4px;
                alignment: end;
                Glyph {
                    visible: root.card.charging;
                    width: root.card.charging ? self.preferred-width : 0;
                    text: "\u{E945}";
                    font-size: root.card.indeterminate ? 26px : 16px;
                    color: root.card.color;
                }
                Text {
                    text: root.card.level-text;
                    font-size: 26px;
                    font-weight: 600;
                    color: root.card.color;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Palette.track;
            Rectangle {
                x: 0;
                width: parent.width * (root.card.indeterminate ? 1 : root.card.fill);
                border-radius: 2px;
                background: root.card.color;
                opacity: root.card.indeterminate ? 0.45 : 1;
            }
        }
    }
}

component OfflineRowView {
    in property <DeviceCard> card;
    opacity: 0.75;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 6px;
        padding-bottom: 6px;
        Glyph {
            width: 38px;
            text: root.card.glyph;
            font-size: 18px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            Text {
                text: root.card.name;
                color: Palette.text;
                overflow: elide;
            }
            Text {
                text: root.card.subtitle;
                font-size: 12px;
                color: Palette.secondary;
                overflow: elide;
            }
        }
    }
}

component DeviceSettingsView inherits Card {
    in property <DeviceSettingsRow> device;
    callback name-edited(string, string);
    callback visible-changed(string, bool);
    callback alerts-changed(string, bool);
    callback thresholds-changed(string, bool);
    callback low-changed(string, int);
    callback critical-changed(string, int);
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 10px;
        HorizontalLayout {
            Glyph {
                width: 34px;
                text: root.device.glyph;
                font-size: 18px;
            }
            Field {
                horizontal-stretch: 1;
                text: root.device.custom-name;
                placeholder: root.device.default-name;
                edited(text) => { root.name-edited(root.device.id, text); }
            }
        }
        VerticalLayout {
            padding-left: 34px;
            spacing: 10px;
            Hint {
                text: root.device.source;
            }
            Toggle {
                text: T.t("device.visible");
                checked: root.device.visible;
                toggled(on) => { root.visible-changed(root.device.id, on); }
            }
            Toggle {
                text: T.t("device.alerts");
                checked: root.device.alerts;
                toggled(on) => { root.alerts-changed(root.device.id, on); }
            }
            Toggle {
                text: T.t("device.thresholds");
                checked: root.device.custom-thresholds;
                toggled(on) => { root.thresholds-changed(root.device.id, on); }
            }
            if root.device.custom-thresholds: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: T.t("alerts.low");
                        color: Palette.text;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.device.low + "%";
                        font-weight: 600;
                        color: Palette.accent;
                    }
                }
                StepSlider {
                    minimum: 10;
                    maximum: 50;
                    label: T.t("alerts.low");
                    value: root.device.low;
                    changed(v) => { root.low-changed(root.device.id, v); }
                }
                HorizontalLayout {
                    padding-top: 8px;
                    Text {
                        text: T.t("alerts.critical");
                        color: Palette.text;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.device.critical + "%";
                        font-weight: 600;
                        color: Palette.accent;
                    }
                }
                StepSlider {
                    minimum: 5;
                    maximum: 45;
                    label: T.t("alerts.critical");
                    value: root.device.critical;
                    changed(v) => { root.critical-changed(root.device.id, v); }
                }
                Hint {
                    text: T.t("alerts.critical.hint");
                }
            }
        }
    }
}

// A section's header, with room above it
component Header inherits VerticalLayout {
    in property <string> text;
    in property <length> top: 14px;
    padding-top: root.top;
    padding-left: 2px;
    SectionHeader {
        text: root.text;
    }
}

// A caption inside a card, above the control it names
component Caption inherits VerticalLayout {
    in property <string> text;
    padding-top: 8px;
    Text {
        text: root.text;
        color: Palette.text;
        wrap: word-wrap;
    }
}

// The field that records the overlay shortcut: focused, it takes the next key combination (read in Rust from the
// raw key event, so it works the same on every keyboard layout)
component ShortcutField inherits Rectangle {
    in property <string> text;
    in property <string> label;
    out property <bool> recording: focus.has-focus;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    background: Palette.input;
    border-color: focus.has-focus ? Palette.accent : Palette.stroke;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: Palette.text;
        vertical-alignment: center;
        overflow: elide;
    }
    focus := FocusScope {
        key-pressed(e) => {
            // Tab leaves the field; every other key is the shortcut, handled before it gets here
            if (e.text == Key.Tab || e.text == Key.Backtab) {
                return reject;
            }
            accept
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); }
    }
}

export component MainWindow inherits Window {
    title: T.t("app.title");
    preferred-width: 440px;
    preferred-height: 640px;
    min-width: 380px;
    min-height: 420px;
    background: Palette.window;
    // Chinese in its own font: the fallback Windows picks for Han on a non-Chinese system is Japanese, which lacks
    // the simplified characters. Microsoft YaHei UI has Latin and Cyrillic too.
    default-font-family: T.lang == "zh" ? "Microsoft YaHei UI" : "Segoe UI";
    default-font-size: 13px;

    in-out property <int> tab: 0;

    // Devices tab
    in property <[DeviceCard]> online;
    in property <[DeviceCard]> offline;
    in property <string> updated-text;
    in property <string> version-text;
    in property <bool> banner-visible;
    in property <string> banner-text;
    in property <bool> banner-button-visible;

    // Settings tab
    in property <string> language;
    in property <bool> overlay-enabled;
    in property <string> shortcut-text;
    in property <string> overlay-status;
    in property <bool> overlay-status-error;
    in property <int> overlay-mode;
    in property <int> overlay-corner;
    in property <bool> overlay-names;
    in property <int> low;
    in property <int> critical;
    in property <int> repeat;
    in property <string> repeat-text;
    in property <bool> sound;
    in property <bool> notify-charged;
    in property <[DeviceSettingsRow]> device-settings;
    in property <string> update-status;
    in property <string> update-notes;
    in property <bool> install-visible;
    in property <string> install-text;
    in property <bool> check-enabled: true;
    in property <bool> auto-update;
    in property <bool> autostart;
    in property <string> elevation-text;
    in-out property <bool> shortcut-focused;
    out property <bool> recording-shortcut: root.tab == 1 && root.shortcut-focused;

    callback refresh();
    callback install-update();
    callback check-updates();
    callback language-chosen(string);
    callback overlay-enabled-changed(bool);
    callback overlay-mode-chosen(int);
    callback overlay-corner-chosen(int);
    callback overlay-names-changed(bool);
    callback overlay-reset();
    callback overlay-preview();
    callback low-changed(int);
    callback critical-changed(int);
    callback repeat-changed(int);
    callback sound-changed(bool);
    callback notify-charged-changed(bool);
    callback test-alert();
    callback auto-update-changed(bool);
    callback autostart-changed(bool);
    callback open-folder();
    callback device-name-edited(string, string);
    callback device-visible-changed(string, bool);
    callback device-alerts-changed(string, bool);
    callback device-thresholds-changed(string, bool);
    callback device-low-changed(string, int);
    callback device-critical-changed(string, int);

    VerticalLayout {
        padding-left: 20px;
        padding-right: 14px;
        padding-top: 14px;
        padding-bottom: 12px;

        HorizontalLayout {
            padding-right: 6px;
            Text {
                text: T.t("app.title");
                font-size: 22px;
                font-weight: 600;
                color: Palette.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                glyph: "\u{E72C}";
                tip: T.t("refresh");
                clicked => { root.refresh(); }
            }
        }

        // Shifted left by the tab's own padding, so its label starts where the title does
        Rectangle {
            height: tabs.preferred-height;
            tabs := HorizontalLayout {
                x: -14px;
                width: parent.width + 14px;
                padding-top: 10px;
                padding-bottom: 14px;
                spacing: 2px;
                alignment: start;
                TabButton {
                    text: T.t("tab.devices");
                    checked: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                TabButton {
                    text: T.t("tab.settings");
                    checked: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
            }
        }

        if root.tab == 0: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding-right: 6px;
                spacing: 8px;
                if root.banner-visible: Card {
                    border-color: Palette.accent;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 10px;
                        Glyph {
                            text: "\u{E896}";
                            font-size: 16px;
                            color: Palette.accent;
                        }
                        Text {
                            text: root.banner-text;
                            color: Palette.text;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        if root.banner-button-visible: Btn {
                            accent: true;
                            text: T.t("upd.banner.button");
                            clicked => { root.install-update(); }
                        }
                    }
                }
                for card in root.online: DeviceCardView {
                    card: card;
                }
                if root.online.length == 0: Card {
                    VerticalLayout {
                        padding: 14px;
                        Text {
                            text: T.t("none.online");
                            color: Palette.secondary;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.offline.length > 0: VerticalLayout {
                    padding-top: 6px;
                    padding-left: 2px;
                    SectionHeader {
                        text: T.t("offline.header");
                    }
                }
                for card in root.offline: OfflineRowView {
                    card: card;
                }
            }
        }

        if root.tab == 1: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding-right: 6px;
                spacing: 8px;

                // Always also says "Language", for someone who can't read the current one
                SectionHeader {
                    text: T.t("lang.header");
                }
                Card {
                    HorizontalLayout {
                        padding: 2px;
                        padding-left: 4px;
                        alignment: start;
                        TabButton {
                            text: T.t("lang.auto");
                            checked: root.language != "ru" && root.language != "en" && root.language != "zh";
                            clicked => { root.language-chosen("auto"); }
                        }
                        TabButton {
                            text: "Русский";
                            checked: root.language == "ru";
                            clicked => { root.language-chosen("ru"); }
                        }
                        TabButton {
                            text: "English";
                            checked: root.language == "en";
                            clicked => { root.language-chosen("en"); }
                        }
                        TabButton {
                            text: "中文";
                            checked: root.language == "zh";
                            clicked => { root.language-chosen("zh"); }
                        }
                    }
                }

                Header {
                    text: T.t("overlay.header");
                    top: 14px;
                }
                Card {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 6px;
                        Toggle {
                            text: T.t("overlay.enabled");
                            checked: root.overlay-enabled;
                            toggled(on) => { root.overlay-enabled-changed(on); }
                        }
                        Caption {
                            text: T.t("overlay.shortcut");
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ShortcutField {
                                horizontal-stretch: 1;
                                changed recording => { root.shortcut-focused = self.recording; }
                                text: root.shortcut-text;
                                label: T.t("overlay.shortcut");
                            }
                            Btn {
                                text: T.t("overlay.reset");
                                clicked => { root.overlay-reset(); }
                            }
                        }
                        Hint {
                            text: T.t("overlay.record.hint");
                        }
                        Text {
                            text: root.overlay-status;
                            font-size: 12px;
                            wrap: word-wrap;
                            color: root.overlay-status-error ? Palette.bad : Palette.offline;
                        }
                        Caption {
                            text: T.t("overlay.mode");
                        }
                        OptionButton {
                            text: T.t("overlay.timed");
                            checked: root.overlay-mode == 0;
                            clicked => { root.overlay-mode-chosen(0); }
                        }
                        OptionButton {
                            text: T.t("overlay.toggle");
                            checked: root.overlay-mode == 1;
                            clicked => { root.overlay-mode-chosen(1); }
                        }
                        Caption {
                            text: T.t("overlay.corner");
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            OptionButton {
                                text: T.t("overlay.top.left");
                                checked: root.overlay-corner == 0;
                                clicked => { root.overlay-corner-chosen(0); }
                            }
                            OptionButton {
                                text: T.t("overlay.top.right");
                                checked: root.overlay-corner == 1;
                                clicked => { root.overlay-corner-chosen(1); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            OptionButton {
                                text: T.t("overlay.bottom.left");
                                checked: root.overlay-corner == 2;
                                clicked => { root.overlay-corner-chosen(2); }
                            }
                            OptionButton {
                                text: T.t("overlay.bottom.right");
                                checked: root.overlay-corner == 3;
                                clicked => { root.overlay-corner-chosen(3); }
                            }
                        }
                        Toggle {
                            text: T.t("overlay.names");
                            checked: root.overlay-names;
                            toggled(on) => { root.overlay-names-changed(on); }
                        }
                        HorizontalLayout {
                            padding-top: 8px;
                            alignment: start;
                            Btn {
                                text: T.t("overlay.preview");
                                clicked => { root.overlay-preview(); }
                            }
                        }
                        Hint {
                            text: T.t("overlay.compatibility");
                        }
                    }
                }

                Header {
                    text: T.t("alerts.header");
                    top: 14px;
                }
                Card {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 6px;
                        HorizontalLayout {
                            Text {
                                text: T.t("alerts.low");
                                color: Palette.text;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.low + "%";
                                font-weight: 600;
                                color: Palette.accent;
                            }
                        }
                        StepSlider {
                            minimum: 10;
                            maximum: 50;
                            label: T.t("alerts.low");
                            value: root.low;
                            changed(v) => { root.low-changed(v); }
                        }
                        HorizontalLayout {
                            padding-top: 8px;
                            Text {
                                text: T.t("alerts.critical");
                                color: Palette.text;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.critical + "%";
                                font-weight: 600;
                                color: Palette.accent;
                            }
                        }
                        StepSlider {
                            minimum: 5;
                            maximum: 45;
                            label: T.t("alerts.critical");
                            value: root.critical;
                            changed(v) => { root.critical-changed(v); }
                        }
                        Hint {
                            text: T.t("alerts.critical.hint");
                        }
                        HorizontalLayout {
                            padding-top: 8px;
                            Text {
                                text: T.t("alerts.repeat");
                                color: Palette.text;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.repeat-text;
                                font-weight: 600;
                                color: Palette.accent;
                            }
                        }
                        StepSlider {
                            minimum: 5;
                            maximum: 60;
                            label: T.t("alerts.repeat");
                            value: root.repeat;
                            changed(v) => { root.repeat-changed(v); }
                        }
                        Toggle {
                            text: T.t("alerts.sound");
                            checked: root.sound;
                            toggled(on) => { root.sound-changed(on); }
                        }
                        Toggle {
                            text: T.t("charged.toggle");
                            checked: root.notify-charged;
                            toggled(on) => { root.notify-charged-changed(on); }
                        }
                        Hint {
                            text: T.t("charged.hint");
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: T.t("alerts.test");
                        clicked => { root.test-alert(); }
                    }
                }

                Header {
                    text: T.t("devices.header");
                    top: 14px;
                }
                for row in root.device-settings: DeviceSettingsView {
                    device: row;
                    name-edited(id, text) => { root.device-name-edited(id, text); }
                    visible-changed(id, on) => { root.device-visible-changed(id, on); }
                    alerts-changed(id, on) => { root.device-alerts-changed(id, on); }
                    thresholds-changed(id, on) => { root.device-thresholds-changed(id, on); }
                    low-changed(id, v) => { root.device-low-changed(id, v); }
                    critical-changed(id, v) => { root.device-critical-changed(id, v); }
                }

                Header {
                    text: T.t("updates.header");
                    top: 6px;
                }
                Card {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 8px;
                        Text {
                            text: root.update-status;
                            color: Palette.text;
                            wrap: word-wrap;
                        }
                        if root.update-notes != "": Hint {
                            text: root.update-notes;
                        }
                        HorizontalLayout {
                            padding-top: 4px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            alignment: start;
                            if root.install-visible: Btn {
                                accent: true;
                                text: root.install-text;
                                clicked => { root.install-update(); }
                            }
                            Btn {
                                text: T.t("updates.check");
                                enabled: root.check-enabled;
                                clicked => { root.check-updates(); }
                            }
                        }
                        Toggle {
                            text: T.t("updates.auto");
                            checked: root.auto-update;
                            toggled(on) => { root.auto-update-changed(on); }
                        }
                        Hint {
                            text: T.t("updates.auto.hint");
                        }
                    }
                }

                Header {
                    text: T.t("system.header");
                    top: 6px;
                }
                Card {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 10px;
                        Toggle {
                            text: T.t("autostart");
                            checked: root.autostart;
                            toggled(on) => { root.autostart-changed(on); }
                        }
                        Hint {
                            text: root.elevation-text;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    padding-bottom: 8px;
                    Btn {
                        text: T.t("open.folder");
                        clicked => { root.open-folder(); }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-top: 10px;
            padding-right: 6px;
            Text {
                text: root.updated-text;
                font-size: 12px;
                color: Palette.secondary;
                horizontal-stretch: 1;
            }
            Text {
                text: root.version-text;
                font-size: 12px;
                color: Palette.secondary;
            }
        }
    }
}

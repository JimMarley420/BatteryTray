// The low battery reminder: a small always-on-top window in the corner of the screen. Unlike
// a toast it isn't swallowed by Do Not Disturb and doesn't time out - it stays until the user picks an answer. It
// never takes focus (see gui.rs), so it doesn't interrupt typing or a game.

import { Palette, T, Glyph, Btn, IconButton } from "theme.slint";

export struct AlertRow {
    glyph: string,
    name: string,
    level: string,
    critical: bool,
}

export component AlertWindow inherits Window {
    title: T.t("alert.title");
    no-frame: true;
    always-on-top: true;
    width: 376px;
    background: Palette.card;
    // Chinese in its own font: the fallback Windows picks for Han on a non-Chinese system is Japanese, which lacks
    // the simplified characters. Microsoft YaHei UI has Latin and Cyrillic too.
    default-font-family: T.lang == "zh" ? "Microsoft YaHei UI" : "Segoe UI";
    default-font-size: 13px;

    in property <[AlertRow]> items;
    in property <bool> critical;
    in property <string> snooze-text;
    callback snooze();
    callback mute();
    // Its height before it is shown, for a first guess at where it goes (text is measured exactly only once the
    // window exists; alert_view.rs places it again then)
    out property <length> content-height: content.preferred-height;

    property <color> accent: root.critical ? Palette.bad : Palette.warn;

    Rectangle {
        x: 0;
        width: 4px;
        background: root.accent;
    }
    // Only what is due and the answers: each device with its level, the two buttons, and the cross (which snoozes)
    content := VerticalLayout {
        padding-left: 22px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 16px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                horizontal-stretch: 1;
                for item in root.items: HorizontalLayout {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    Glyph {
                        width: 30px;
                        text: item.glyph;
                        font-size: 17px;
                    }
                    Text {
                        text: item.name;
                        font-size: 14px;
                        color: Palette.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: item.level;
                        font-size: 20px;
                        font-weight: 600;
                        color: item.critical ? Palette.bad : Palette.warn;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: start;
                IconButton {
                    glyph: "\u{E711}";
                    glyph-size: 12px;
                    tip: T.t("alert.snooze.tip");
                    clicked => { root.snooze(); }
                }
            }
        }
        VerticalLayout {
            padding-top: 12px;
            padding-right: 8px;
            spacing: 8px;
            Btn {
                accent: true;
                text: root.snooze-text;
                clicked => { root.snooze(); }
            }
            Btn {
                text: T.t("alert.mute");
                clicked => { root.mute(); }
            }
        }
    }
}

// The low battery reminder: a small always-on-top window in the corner of the screen. Unlike
// a toast it isn't swallowed by Do Not Disturb. It stays until the user picks an answer, or, when the settings say so,
// closes on its own after a few seconds (a line along its bottom edge shows the time left). It never takes focus (see
// gui.rs), so it doesn't interrupt typing or a game.

import { Palette, T, Glyph, Btn, IconButton } from "theme.slint";

export struct AlertRow {
    glyph: string,
    name: string,
    level: string,
    percent: int,
    critical: bool,
}

export component AlertWindow inherits Window {
    title: T.t("alert.title");
    no-frame: true;
    always-on-top: true;
    width: 376px;
    background: Palette.card;
    // Chinese in its own font: the fallback Windows picks for Han on a non-Chinese system is Japanese, which lacks
    // the simplified characters. Microsoft YaHei UI has Latin and Cyrillic too.
    default-font-family: T.lang == "zh" ? "Microsoft YaHei UI" : "Segoe UI";
    default-font-size: 13px;

    in property <[AlertRow]> items;
    in property <bool> critical;
    in property <string> snooze-text;
    // Closes on its own: the share of its time still left, 1 to 0
    in property <bool> auto-close;
    in property <float> remaining: 1;
    callback snooze();
    callback mute();
    // Its height before it is shown, for a first guess at where it goes (text is measured exactly only once the
    // window exists; alert_view.rs places it again then)
    out property <length> content-height: content.preferred-height;

    // A header with the app's name and the cross (which snoozes), the devices, the two answers. The severity is in
    // the levels' color only; the window's border stays neutral.
    content := VerticalLayout {
        padding-bottom: 16px;
        HorizontalLayout {
            padding-top: 4px;
            padding-left: 16px;
            padding-right: 4px;
            spacing: 8px;
            Glyph {
                text: "\u{E83F}";
                font-size: 14px;
            }
            Text {
                text: "BatteryTray";
                font-size: 12px;
                color: Palette.secondary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                glyph: "\u{E711}";
                glyph-size: 12px;
                tip: T.t("alert.snooze.tip");
                clicked => { root.snooze(); }
            }
        }
        VerticalLayout {
            padding-top: 2px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            for item in root.items: HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 8px;
                    background: Palette.stroke;
                    Glyph {
                        text: item.glyph;
                        font-size: 20px;
                        color: Palette.text;
                        horizontal-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    horizontal-stretch: 1;
                    Text {
                        text: item.name;
                        font-size: 14px;
                        font-weight: 600;
                        color: Palette.text;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Palette.track;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0, min(100, item.percent)) / 100;
                            border-radius: 2px;
                            background: item.critical ? Palette.bad : Palette.warn;
                        }
                    }
                }
                Text {
                    min-width: 56px;
                    text: item.level;
                    font-size: 24px;
                    font-weight: 600;
                    color: item.critical ? Palette.bad : Palette.warn;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            padding-top: 16px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            Btn {
                accent: true;
                text: root.snooze-text;
                clicked => { root.snooze(); }
            }
            Btn {
                text: T.t("alert.mute");
                clicked => { root.mute(); }
            }
        }
    }
    // The time left, shrinking towards the left; it stands still while the pointer is over the window
    if root.auto-close: Rectangle {
        x: 0;
        y: root.height - self.height;
        width: root.width * max(0, min(1, root.remaining));
        height: 3px;
        background: Palette.accent;
    }
}

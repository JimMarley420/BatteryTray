// The app's look (UI/Styles.xaml): the Windows 11 dark palette, and the few controls the windows use, drawn the
// same way as in the C# app.

export global Palette {
    out property <color> window: #202020;
    out property <color> card: #2B2B2B;
    out property <color> stroke: #363636;
    out property <color> control: #323232;
    out property <color> control-hover: #3B3B3B;
    out property <color> control-pressed: #2A2A2A;
    out property <color> input: #1F1F1F;
    out property <color> text: #F3F3F3;
    out property <color> secondary: #9E9E9E;
    out property <color> track: #404040;
    out property <color> accent: #60CDFF;
    out property <color> accent-hover: #85D9FF;
    out property <color> good: #6CCB5F;
    out property <color> warn: #F7C04A;
    out property <color> bad: #FF6B6B;
    out property <color> offline: #7A7A7A;
}

// The app's texts: Rust answers T.tr(language, key); a binding that reads `lang` follows a change of language.
export global T {
    in-out property <string> lang: "en";
    // Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10
    in property <string> icon-font: "Segoe Fluent Icons";
    pure callback tr(string, string) -> string;
    public pure function t(key: string) -> string {
        return self.tr(self.lang, key);
    }
}

export component Glyph inherits Text {
    font-family: T.icon-font;
    font-size: 20px;
    color: Palette.secondary;
    vertical-alignment: center;
    accessible-role: none;
}

export component Card inherits Rectangle {
    background: Palette.card;
    border-color: Palette.stroke;
    border-width: 1px;
    border-radius: 8px;
}

export component SectionHeader inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Palette.secondary;
}

export component Hint inherits Text {
    font-size: 12px;
    color: Palette.secondary;
    wrap: word-wrap;
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> accent;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 32px;
    border-radius: 4px;
    border-width: 1px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.accent
        ? (touch.has-hover && root.enabled && !touch.pressed ? Palette.accent-hover : Palette.accent)
        : (touch.pressed ? Palette.control-pressed : touch.has-hover && root.enabled ? Palette.control-hover : Palette.control);
    border-color: root.accent ? self.background : Palette.stroke;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        label := Text {
            text: root.text;
            color: root.accent ? #000000 : Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <length> glyph-size: 15px;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 4px;
    background: touch.pressed ? Palette.control-pressed : touch.has-hover ? Palette.control-hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    Glyph {
        text: root.glyph;
        font-size: root.glyph-size;
        color: Palette.text;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Tab header and language choice: the label in grey, white and underlined with the accent when chosen
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    border-radius: 4px;
    background: touch.has-hover ? Palette.card : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 7px;
        padding-bottom: 7px;
        label := Text {
            text: root.text;
            font-size: 14px;
            color: root.checked ? Palette.text : Palette.secondary;
        }
    }
    Rectangle {
        x: 14px;
        y: parent.height - 3px;
        width: parent.width - 28px;
        height: 3px;
        border-radius: 1.5px;
        background: Palette.accent;
        visible: root.checked;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Toggle switch with its label on the left. It only asks for the change (`toggled`); `checked` always shows what the
// app has, so a change the app refuses (autostart without the UAC prompt accepted) doesn't show as made.
export component Toggle {
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);
    min-height: 22px;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }
    function flip() {
        root.toggled(!root.checked);
    }
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: root.text;
            color: Palette.text;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 20px;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.checked ? Palette.accent : #9A9A9A;
                background: root.checked ? Palette.accent : transparent;
                knob := Rectangle {
                    width: touch.has-hover ? 14px : 12px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.checked ? #1A1A1A : #CFCFCF;
                    x: root.checked ? parent.width - self.width - 4px : 4px;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
}

// Radio option: the same ring, accent and dot as the toggle switch
export component OptionButton {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.checked ? Palette.accent : #9A9A9A;
                background: root.checked ? Palette.accent
                    : touch.pressed ? Palette.control-pressed : touch.has-hover ? Palette.control-hover : transparent;
                Rectangle {
                    visible: root.checked;
                    width: touch.pressed ? 10px : touch.has-hover ? 14px : 12px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: #1A1A1A;
                }
            }
        }
        Text {
            text: root.text;
            color: Palette.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Slider in steps (5%), the part up to the knob in the accent color. As the toggle, it only asks for a value
// (`changed`); `value` shows what the app has, also when it moves another slider along (the critical level stays
// 5 below the reminder level).
export component StepSlider {
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 5;
    in property <string> label;
    in property <int> value;
    callback changed(int);
    height: 24px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.set(root.value + root.step); }
    accessible-action-decrement => { root.set(root.value - root.step); }
    property <length> knob-x: (root.width - 20px) * (root.value - root.minimum) / (root.maximum - root.minimum);
    function set(v: int) {
        let snapped = max(root.minimum, min(root.maximum, v));
        if (snapped != root.value) {
            root.changed(snapped);
        }
    }
    function set-from(x: length) {
        let ratio = max(0, min(1, (x - 10px) / (root.width - 20px)));
        root.set(root.minimum + round(ratio * (root.maximum - root.minimum) / root.step) * root.step);
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Palette.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.knob-x + 10px;
        height: 4px;
        border-radius: 2px;
        background: Palette.accent;
    }
    Rectangle {
        x: root.knob-x;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #454545;
        border-color: #555555;
        border-width: 1px;
        Rectangle {
            width: touch.has-hover ? 13px : 10px;
            height: self.width;
            border-radius: self.width / 2;
            background: Palette.accent;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// Text box with a grey placeholder while empty
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback edited(string);
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    background: Palette.input;
    border-color: input.has-focus ? Palette.accent : Palette.stroke;
    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.placeholder;
        color: Palette.secondary;
        vertical-alignment: center;
        overflow: elide;
        visible: input.text == "";
    }
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        color: Palette.text;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Palette.accent;
        selection-foreground-color: #000000;
        accessible-label: root.placeholder;
        edited => { root.edited(self.text); }
    }
}
